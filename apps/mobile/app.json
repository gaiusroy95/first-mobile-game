{
  "expo": {
    "name": "Battle Formation",
    "slug": "battle-formation",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon-bf.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon-bf.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1210"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.battleformation.mobile"
    },
    "android": {
      "package": "com.battleformation.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b1210",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-bf.png",
      "bundler": "metro"
    },
    "plugins": ["expo-asset"]
  }
}
