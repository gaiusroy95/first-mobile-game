# Copy to .env and fill in. Never commit .env.
# Vars must be prefixed EXPO_PUBLIC_ to be readable from app code.

# Local backend (recommended while developing):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# Android emulator → host machine:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000

# Physical device: use your PC LAN IP, e.g. http://192.168.1.10:3000

# Hosted backend (only when the host TLS certificate is healthy):
# EXPO_PUBLIC_API_BASE_URL=https://first-mobile-game.onrender.com
# EXPO_PUBLIC_SOCKET_URL=https://first-mobile-game.onrender.com
