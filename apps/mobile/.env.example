# Copy to .env (Expo loads this automatically - no extra config needed).
# Vars must be prefixed EXPO_PUBLIC_ to be readable from app code; see
# src/api/http/client.ts and src/api/socket/client.ts for where these are
# read. Both default to http://localhost:3000 if unset, so this file is
# only needed to point the app at something other than a local backend.

# Local backend (npm run dev in apps/backend):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# Deployed backend (e.g. Render) - same host for both, https upgrades the
# socket connection to wss automatically:
# EXPO_PUBLIC_API_BASE_URL=https://battle-formation-backend.onrender.com
# EXPO_PUBLIC_SOCKET_URL=https://battle-formation-backend.onrender.com
